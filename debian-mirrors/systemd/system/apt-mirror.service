[Unit]
Description=Run apt-mirror
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=$$USER$$
Group=$$GROUP$$
WorkingDirectory=$$WORKING_DIRECTORY$$
ExecStartPre=bash -c 'echo "$(date -Iseconds): apt-mirror starting" >> apt-mirror.log'
ExecStart=/usr/bin/apt-mirror
ExecStopPost=/bin/sh -c 'echo "$(date -Iseconds): apt-mirror ended" >> apt-mirror.log'

[Install]
WantedBy=multi-user.target
